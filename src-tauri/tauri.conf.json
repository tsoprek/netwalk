{
  "$schema": "https://schema.tauri.app/config/2.0.0-beta",
  "productName": "ConneCat",
  "version": "0.1.0",
  "identifier": "io.connecat.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1430",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ConneCat",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:1430 ws://localhost:1430 wss:; object-src 'none'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$PICTURE/**",
          "$DOWNLOAD/**",
          "$DESKTOP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons-standalone/32x32.png",
      "icons-standalone/128x128.png",
      "icons-standalone/128x128@2x.png",
      "icons-standalone/icon.icns",
      "icons-standalone/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
